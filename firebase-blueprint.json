{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with fan digital card data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier matching auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Fan full name or display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "fanCardNumber": {
          "type": "string",
          "description": "Unique fan card number (e.g. FCP-1893-XXXX)"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "description": "User profiles and digital fan member cards"
    }
  }
}
